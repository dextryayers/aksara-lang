# Fungsi sebagai nilai

fungsi kuadrat(x):
    kembalikan x * x
operasi = kuadrat
pastikan (operasi(4)) == (16), "operasi(4)"
daftar_fungsi = [kuadrat, lambda x: x + 1]
pastikan (daftar_fungsi[0](3)) == (9), "daftar_fungsi[0](3)"
pastikan (daftar_fungsi[1](3)) == (4), "daftar_fungsi[1](3)"

cetak("OK")
