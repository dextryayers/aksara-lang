# Prioritas operator

pastikan (2 + 3 * 4) == (14), "2 + 3 * 4"
pastikan ((2 + 3) * 4) == (20), "(2 + 3) * 4"
pastikan (2 ** 3 ** 2) == (512), "2 ** 3 ** 2"
pastikan (10 - 2 - 3) == (5), "10 - 2 - 3"
pastikan (100 / 10 / 2) == (5.0), "100 / 10 / 2"
pastikan (1 + 2 * 3 ** 2) == (19), "1 + 2 * 3 ** 2"

cetak("OK")
