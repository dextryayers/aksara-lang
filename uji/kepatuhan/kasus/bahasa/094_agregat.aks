# Agregat koleksi

pastikan (jumlah([1, 2, 3])) == (6), "jumlah([1, 2, 3])"
pastikan (jumlah([1, 2, 3], 10)) == (16), "jumlah([1, 2, 3], 10)"
pastikan (maks([1, 3, 2])) == (3), "maks([1, 3, 2])"
pastikan (min([1, 3, 2])) == (1), "min([1, 3, 2])"
pastikan (maks(1, 5, 3)) == (5), "maks(1, 5, 3)"
pastikan (min(1, 5, 3)) == (1), "min(1, 5, 3)"
pastikan (maks([], default=7)) == (7), "maks([], default=7)"
pastikan (semua([benar, benar])) == (benar), "semua([benar, benar])"
pastikan (semua([benar, salah])) == (salah), "semua([benar, salah])"
pastikan (apa_saja([salah, benar])) == (benar), "apa_saja([salah, benar])"
pastikan (apa_saja([salah, salah])) == (salah), "apa_saja([salah, salah])"

cetak("OK")
