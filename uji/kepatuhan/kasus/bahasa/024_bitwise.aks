# Operator bitwise

pastikan (6 & 3) == (2), "6 & 3"
pastikan (6 | 3) == (7), "6 | 3"
pastikan (6 ^ 3) == (5), "6 ^ 3"
pastikan (~5) == (-6), "~5"
pastikan (1 << 4) == (16), "1 << 4"
pastikan (32 >> 3) == (4), "32 >> 3"
pastikan (benar & salah) == (salah), "benar & salah"
pastikan (benar | salah) == (benar), "benar | salah"
pastikan (benar ^ benar) == (salah), "benar ^ benar"

cetak("OK")
