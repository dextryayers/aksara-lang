# Daftar dasar

pastikan ([1, 2, 3]) == ([1, 2, 3]), "[1, 2, 3]"
pastikan ([]) == ([]), "[]"
pastikan (panjang([1, 2, 3])) == (3), "panjang([1, 2, 3])"
pastikan ([10, 20, 30][0]) == (10), "[10, 20, 30][0]"
pastikan ([10, 20, 30][-1]) == (30), "[10, 20, 30][-1]"
pastikan ([10, 20, 30][1:3]) == ([20, 30]), "[10, 20, 30][1:3]"
pastikan ([10, 20, 30][::-1]) == ([30, 20, 10]), "[10, 20, 30][::-1]"

cetak("OK")
